{
  "name": "@workbench/server",
  "version": "0.1.0",
  "private": true,
  "description": "直播创意工作台后端：Node.js + TypeScript + Fastify 模块化单体",
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/server.ts",
    "start": "node src/server.ts",
    "migrate": "node --env-file-if-exists=.env src/migrate-cli.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@workbench/contracts": "0.1.0",
    "fastify": "^5.12.5",
    "pg": "^8.23.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1"
  }
}
