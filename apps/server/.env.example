# 复制为 .env 供本地开发（.env 不入库）。不要在此写入任何生产凭据。
DATABASE_URL=postgres://workbench:workbench@127.0.0.1:55432/workbench
HOST=127.0.0.1
PORT=3000
# dev：缺省身份为 dev（operator+reviewer），仅限本机开发。
# trusted-proxy：必须由可信代理注入 x-workbench-user / x-workbench-roles 并携带共享密钥。
AUTH_MODE=dev
# AUTH_MODE=trusted-proxy 时必填，通过部署环境的安全渠道配置。
PROXY_SHARED_SECRET=
