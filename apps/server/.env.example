# 复制为 .env 供本地开发（.env 不入库）。不要在此写入任何生产凭据。
DATABASE_URL=postgres://workbench:workbench@127.0.0.1:55432/workbench
HOST=127.0.0.1
PORT=3000
# dev：缺省身份为 dev（operator/reviewer/dispatcher/launcher），仅限本机开发。
# trusted-proxy：必须由可信代理注入 x-workbench-user / x-workbench-roles 并携带共享密钥。
AUTH_MODE=dev
# AUTH_MODE=trusted-proxy 时必填，通过部署环境的安全渠道配置。
PROXY_SHARED_SECRET=

# ----- ROBB-11 集成（全部可留空：留空即“未配置”，投稿与审核照常可用）-----
# 生产值只在部署主机配置，不写入仓库、任务或评论。见 docs/backend.md。
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
# 部署主机上独立登录的非 default CLI 配置名；不得在 agent run 内运行工作台。
WORKBENCH_MULTICA_PROFILE=
WORKBENCH_MULTICA_WORKSPACE_ID=
WORKBENCH_MULTICA_PROJECT_ID=
WORKBENCH_PRODUCT_REPO_URL=
# 写入与启动两道独立授权，缺省关闭。
WORKBENCH_MULTICA_WRITES_ENABLED=false
WORKBENCH_MULTICA_EXECUTION_ENABLED=false
