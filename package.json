{
  "name": "live-idea-workbench",
  "private": true,
  "description": "你出创意，我出 token｜直播创意收集、人工选题审核与 Multica 任务分配工作台",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "db:up": "docker compose up -d db",
    "db:migrate": "npm run migrate -w @workbench/server",
    "dev:server": "npm run dev -w @workbench/server",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  }
}
